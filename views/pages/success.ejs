<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <title>User Registered</title>

    <!-- Bootstrap CSS -->
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">

    <style>
        body {
            background: linear-gradient(135deg, #0b0f2b, #11153a);
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            color: #fff;
            font-family: 'Poppins', sans-serif;
        }

        .anime-card {
            background-color: #0f172a;
            border-radius: 12px;
            box-shadow: 0 0 25px rgba(255, 0, 80, 0.25);
            padding: 30px;
            width: 100%;
            max-width: 520px;
        }

        .anime-card h3 {
            text-align: center;
            margin-bottom: 20px;
            color: #DC3545;
            font-weight: 600;
        }

        table {
            color: #dc6c10;
        }

        th {
            width: 30%;
            color: #5a6982;
            font-weight: 500;
        }

        td {
            color: #f9fafb;
        }
    </style>
</head>
<body>

    <div class="anime-card">
        <h3>User Registered Successfully</h3>

        <table class="table table-borderless align-middle mb-0">
            <tbody>
                <tr>
                    <th>Email</th>
                    <td><%= email %></td>
                </tr>
                <tr>
                    <th>Password</th>
                    <td><%= password %></td>
                </tr>
            </tbody>
        </table>
    </div>

</body>
</html>
